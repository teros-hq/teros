# Dependencies
node_modules/

# Build output
dist/
/data/

# Environment & secrets
.env
.env.deploy
.secrets/**/*.json
!.secrets/**/*.example.json
!.secrets/README.md
# Secret real montado en el stack de test local (CI usa GitHub Secrets, no el repo) — nunca a git.
.secrets-ci/
# Artefactos de Playwright (reporter, screenshots, traces).
test-results/
playwright-report/

# Deploy state (written by deploy-server.sh on the prod working tree, TER-519)
.last-good-sha

# Terraform secrets — never commit actual values
# ⚠️ CRITICAL: These files contain real secrets - never commit them
infra/terraform/terraform.tfvars
infra/terraform/*.tfplan
infra/terraform/tfplan.out
infra/terraform/*.auto.tfvars
infra/terraform/.terraform/
infra/terraform/.terraform.lock.hcl

# Local environment files (may contain secrets)
.env
.env.*
!.env.example
!.env.test.example

# Secrets directory (only examples allowed)
.secrets/**/*.json
!.secrets/**/*.example.json
!.secrets/README.md

# Logs
*.log
logs/

# OS
.DS_Store

# Media uploads
packages/backend/media/

# Stale Expo web-export snapshot — dead code path (PUBLIC_DIR/handlePublicFile is
# unreachable in the current nginx + separate-Expo-frontend architecture; the real
# static source is packages/app/public/, bundled by `expo export` into dist/).
packages/backend/public/

# Ansible
infra/ansible/.vault-pass
/backups
/workspace

# Generated by scripts/gen-mca-union-deps.mjs before each mca-runtime build
docker/mca-runtime/deps.generated.json
docker/mca-runtime-playwright/deps.generated.json
