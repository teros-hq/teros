{
  "$schema": "https://teros.ai/schemas/mca-tools.json",
  "mcaId": "mca.odoo",
  "tools": [
    {
      "name": "-health-check",
      "description": "Internal health check tool. Verifies Odoo API key and connectivity.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "list-models",
      "description": "List all available Odoo models (ir.model).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Maximum number of results (default: 100)"
          },
          "offset": {
            "type": "number",
            "description": "Pagination offset"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "search-records",
      "description": "Search and read records from any Odoo model. Use filters like \"is_company=true,name=Acme\".",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "Odoo model technical name, e.g. res.partner"
          },
          "filters": {
            "type": "string",
            "description": "Comma-separated filters: field=value, field!=value, field>value, etc."
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Fields to return (default: all stored fields)"
          },
          "limit": {
            "type": "number",
            "description": "Maximum results (default: 50)"
          },
          "offset": {
            "type": "number",
            "description": "Pagination offset"
          },
          "order": {
            "type": "string",
            "description": "Order clause, e.g. name asc"
          }
        },
        "required": [
          "model"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "get-record",
      "description": "Read a single Odoo record by model and ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "Odoo model technical name"
          },
          "id": {
            "type": "number",
            "description": "Record ID"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Fields to return"
          }
        },
        "required": [
          "model",
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "create-record",
      "description": "Create a new record in any Odoo model.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "Odoo model technical name"
          },
          "values": {
            "type": "object",
            "description": "Field values for the new record",
            "additionalProperties": true
          }
        },
        "required": [
          "model",
          "values"
        ]
      },
      "annotations": {
        "readOnlyHint": false
      }
    },
    {
      "name": "update-record",
      "description": "Update an existing Odoo record by model and ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "Odoo model technical name"
          },
          "id": {
            "type": "number",
            "description": "Record ID"
          },
          "values": {
            "type": "object",
            "description": "Field values to update",
            "additionalProperties": true
          }
        },
        "required": [
          "model",
          "id",
          "values"
        ]
      },
      "annotations": {
        "readOnlyHint": false
      }
    },
    {
      "name": "delete-record",
      "description": "Delete an Odoo record by model and ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "Odoo model technical name"
          },
          "id": {
            "type": "number",
            "description": "Record ID"
          }
        },
        "required": [
          "model",
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": false
      }
    },
    {
      "name": "count-records",
      "description": "Count records in an Odoo model matching the given filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "Odoo model technical name"
          },
          "filters": {
            "type": "string",
            "description": "Comma-separated filters: field=value, field!=value, etc."
          }
        },
        "required": [
          "model"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "call-method",
      "description": "Call any public method on an Odoo model.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "Odoo model technical name"
          },
          "method": {
            "type": "string",
            "description": "Method name to call"
          },
          "args": {
            "type": "array",
            "description": "Positional arguments passed to the method",
            "items": {}
          },
          "kwargs": {
            "type": "object",
            "description": "Keyword arguments passed to the method",
            "additionalProperties": true
          }
        },
        "required": [
          "model",
          "method"
        ]
      },
      "annotations": {
        "readOnlyHint": false
      }
    },
    {
      "name": "list-partners",
      "description": "List Odoo partners (contacts / companies).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "filters": {
            "type": "string",
            "description": "Comma-separated filters, e.g. is_company=true,name=Acme"
          },
          "limit": {
            "type": "number",
            "description": "Maximum results (default: 50)"
          },
          "offset": {
            "type": "number",
            "description": "Pagination offset"
          },
          "order": {
            "type": "string",
            "description": "Order clause, e.g. name asc"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "get-partner",
      "description": "Get a specific Odoo partner by ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Partner ID"
          }
        },
        "required": [
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "create-partner",
      "description": "Create a new Odoo partner (contact or company).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Partner name"
          },
          "email": {
            "type": "string",
            "description": "Email address"
          },
          "phone": {
            "type": "string",
            "description": "Phone number"
          },
          "isCompany": {
            "type": "boolean",
            "description": "Whether this is a company"
          },
          "street": {
            "type": "string",
            "description": "Street address"
          },
          "city": {
            "type": "string",
            "description": "City"
          },
          "zip": {
            "type": "string",
            "description": "ZIP / postal code"
          },
          "countryId": {
            "type": "number",
            "description": "Country ID"
          },
          "parentId": {
            "type": "number",
            "description": "Parent company ID"
          },
          "values": {
            "type": "object",
            "description": "Additional field values",
            "additionalProperties": true
          }
        },
        "required": [
          "name"
        ]
      },
      "annotations": {
        "readOnlyHint": false
      }
    },
    {
      "name": "update-partner",
      "description": "Update an existing Odoo partner by ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Partner ID"
          },
          "values": {
            "type": "object",
            "description": "Field values to update",
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "values"
        ]
      },
      "annotations": {
        "readOnlyHint": false
      }
    },
    {
      "name": "list-products",
      "description": "List Odoo products (product.template).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "filters": {
            "type": "string",
            "description": "Comma-separated filters, e.g. sale_ok=true"
