        "type": "object",
        "properties": {
          "projectId": {
            "type": "number",
            "description": "Filter by project ID"
          },
          "filters": {
            "type": "string",
            "description": "Additional comma-separated filters"
          },
          "limit": {
            "type": "number",
            "description": "Maximum results (default: 50)"
          },
          "offset": {
            "type": "number",
            "description": "Pagination offset"
          },
          "order": {
            "type": "string",
            "description": "Order clause, e.g. date_deadline asc"
          }
        }
      },
      "annotations": {
