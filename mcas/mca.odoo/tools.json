          },
          "holidayStatusId": {
            "type": "number",
            "description": "Leave type ID"
          },
          "dateFrom": {
            "type": "string",
            "description": "Start date/time (ISO 8601)"
          },
          "dateTo": {
            "type": "string",
            "description": "End date/time (ISO 8601)"
          },
          "name": {
            "type": "string",
            "description": "Reason / description"
          }
        },
        "required": [
          "employeeId",
          "holidayStatusId",
          "dateFrom",
          "dateTo"
        ]
      },
      "annotations": {
        "readOnlyHint": false
      }
    },
