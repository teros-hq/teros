          },
          "order": {
            "type": "string",
            "description": "Order clause, e.g. name asc"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "list-sale-orders",
      "description": "List Odoo sales orders.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "filters": {
            "type": "string",
            "description": "Comma-separated filters, e.g. state=sale"
          },
          "limit": {
            "type": "number",
            "description": "Maximum results (default: 50)"
          },
          "offset": {
            "type": "number",
            "description": "Pagination offset"
          },
          "order": {
            "type": "string",
            "description": "Order clause, e.g. date_order desc"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "get-sale-order",
      "description": "Get a specific Odoo sales order by ID, including order lines.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Sales order ID"
          }
        },
        "required": [
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "create-sale-order",
      "description": "Create a new Odoo sales order with optional order lines.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "partnerId": {
            "type": "number",
            "description": "Customer partner ID"
          },
          "orderLines": {
            "type": "array",
            "description": "Order lines as objects with productId, quantity, priceUnit",
            "items": {
              "type": "object",
              "properties": {
                "productId": {
                  "type": "number"
                },
                "quantity": {
                  "type": "number"
                },
                "priceUnit": {
                  "type": "number"
                }
              },
              "required": [
                "productId",
                "quantity"
              ]
            }
          },
          "dateOrder": {
            "type": "string",
            "description": "Order date (ISO 8601)"
          },
          "note": {
            "type": "string",
            "description": "Internal note"
          }
        },
        "required": [
          "partnerId"
        ]
      },
      "annotations": {
        "readOnlyHint": false
      }
    },
    {
      "name": "list-invoices",
      "description": "List Odoo customer invoices (account.move).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "filters": {
            "type": "string",
            "description": "Comma-separated filters, e.g. state=posted"
          },
          "limit": {
            "type": "number",
            "description": "Maximum results (default: 50)"
