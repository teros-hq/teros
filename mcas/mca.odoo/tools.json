          },
          "filters": {
            "type": "string",
            "description": "Additional comma-separated filters"
          },
          "limit": {
            "type": "number",
            "description": "Maximum results (default: 50)"
          },
          "offset": {
            "type": "number",
            "description": "Pagination offset"
          },
          "order": {
            "type": "string",
            "description": "Order clause, e.g. date_from desc"
          }
        }
