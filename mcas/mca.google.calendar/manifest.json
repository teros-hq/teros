{
  "$schema": "https://teros.ai/schemas/mca-manifest.json",
  "id": "mca.google.calendar",
  "name": "Google Calendar",
  "version": "2.0.0",
  "description": "Manage Google Calendar: discover calendars, list/get/search events, create/update/delete events with recurrence + Meet + reminders + RSVP notifications, check availability",
  "type": "integration",
  "icon": "icon.png",
  "category": "google",
  "entrypoint": "src/index.ts",
  "author": {
    "name": "Teros Team",
    "email": "team@teros.ai"
  },
  "availability": {
    "enabled": true,
    "multi": true,
    "system": false,
    "hidden": false,
    "role": "user"
  },
  "layers": {
    "tools": true,
    "events": false,
    "ui": false,
    "permissions": false,
    "auth": {
      "type": "oauth2",
      "provider": "google",
      "systemSecrets": ["CLIENT_ID", "CLIENT_SECRET", "REDIRECT_URIS"],
      "userSecrets": ["ACCESS_TOKEN", "REFRESH_TOKEN", "EMAIL", "EXPIRY_DATE"],
      "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
      "tokenUrl": "https://oauth2.googleapis.com/token",
      "scopes": [
        "https://www.googleapis.com/auth/calendar",
        "https://www.googleapis.com/auth/userinfo.email"
      ],
      "pkce": false
    },
    "agent": false
  },
  "runtime": {
    "transport": "http",
    "port": 3000,
    "healthCheck": "/health",
    "containerMode": "per-app"
  },
  "keywords": ["google", "calendar", "events", "scheduling", "meetings"],
  "changelog": [
    {
      "version": "2.0.0",
      "date": "2026-04-30",
      "notes": "Browse calendars, create and manage events with recurrence and Meet, RSVP, and check free-busy availability"
    }
  ]
}
