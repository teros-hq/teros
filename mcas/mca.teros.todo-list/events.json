    {
      "topic": "todo.task_created",
      "description": "A task (or group) was created in the to-do list.",
      "payload": {
        "workspaceId": "string",
        "nodeId": "string (task node ID)",
        "text": "string (task title)",
        "parentId": "string | null",
        "state": "string (new state)",
        "assigneeKind": "'agent' | 'user'",
        "assigneeId": "string (assignee id)",
        "channelId": "string | null (task conversation)",
        "actorAgentId": "string (agent that caused it)",
        "actorUserId": "string (user that caused it)",
        "occurredAt": "ISO date",
        "parentText": "string (parent's title)"
      },
      "filters": {
        "nodeId": {
          "type": "string",
          "operator": "equals",
          "description": "Only events for this specific task (node ID) — 'avísame cuando ESTA tarea termine'."
        },
        "groupNodeIds": {
          "type": "string",
          "operator": "anyOf",
          "description": "Only events for tasks inside this group's subtree (group node ID)."
        },
        "assigneeId": {
          "type": "string",
          "operator": "equals",
          "description": "Only events where the task is assigned to this agent/user."
        },
        "workspaceId": {
          "type": "string",
          "operator": "equals",
          "description": "Only events of this workspace (backend envelope)."
        }
      }
