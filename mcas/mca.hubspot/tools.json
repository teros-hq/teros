        "type": "object",
        "properties": {
          "contactId": {
            "type": "string",
            "description": "Contact ID (HubSpot ID) or email if idProperty=email."
          },
          "idProperty": {
            "type": "string",
            "description": "Identifier type: \"email\" to lookup by email address. Default uses HubSpot ID."
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional properties to include."
          }
        },
        "required": [
          "contactId"
        ]
