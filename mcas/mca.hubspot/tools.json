  "mcaId": "mca.hubspot",
  "tools": [
    {
      "name": "-health-check",
      "description": "Internal health check tool. Verifies HubSpot OAuth credentials and connectivity.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
