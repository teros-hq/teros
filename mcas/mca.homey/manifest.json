{
  "$schema": "https://teros.ai/schemas/mca-manifest.json",
  "id": "mca.homey",
  "name": "Homey",
  "version": "1.0.0",
  "description": "Homey smart home controller - Control devices, manage flows, and monitor your home via Athom Cloud API",
  "type": "integration",
  "icon": "icon.png",
  "category": "other",
  "entrypoint": "src/index.ts",
  "author": {
    "name": "Alice Evergreen",
    "email": "alice@teros.ai"
  },
  "availability": {
    "enabled": true,
    "multi": true,
    "system": false,
    "hidden": false,
    "role": "user"
  },
  "layers": {
    "tools": true,
    "events": false,
    "ui": false,
    "permissions": false,
    "auth": {
      "type": "oauth2",
      "provider": "homey",
      "systemSecrets": ["CLIENT_ID", "CLIENT_SECRET"],
      "userSecrets": ["ACCESS_TOKEN", "REFRESH_TOKEN", "TOKEN_TYPE", "EXPIRES_IN"],
      "authorizeUrl": "https://api.athom.com/oauth2/authorise",
      "tokenUrl": "https://api.athom.com/oauth2/token",
      "scopes": [
        "account.homeys",
        "homey.app.readonly",
        "homey.device.readonly",
        "homey.device.control",
        "homey.energy.readonly",
        "homey.flow.readonly",
        "homey.flow.start",
        "homey.insights.readonly",
        "homey.logic",
        "homey.logic.readonly",
        "homey.notifications.readonly",
        "homey.presence.readonly",
        "homey.presence.self",
        "homey.user.readonly",
        "homey.user.self",
        "homey.zone.readonly"
      ],
      "scopeSeparator": ",",
      "pkce": false
    },
    "agent": false
  },
  "runtime": {
    "transport": "http",
    "port": 3000,
    "healthCheck": "/health",
    "containerMode": "per-app"
  },
  "keywords": ["homey", "other", "home-automation", "iot", "devices", "flows", "athom"],
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-03-16",
      "notes": "Initial release — control smart home devices, run automation flows, manage rooms and variables, and monitor live energy"
    }
  ]
}
