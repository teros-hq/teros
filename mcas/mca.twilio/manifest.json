{
  "$schema": "https://teros.ai/schemas/mca-manifest.json",
  "id": "mca.twilio",
  "name": "Twilio",
  "version": "1.0.0",
  "description": "Twilio integration - manage phone numbers, send SMS, and track calls directly from your Twilio account",
  "type": "integration",
  "icon": "icon.svg",
  "category": "communication",
  "entrypoint": "./src/index.ts",
  "runtime": {
    "transport": "http",
    "containerMode": "per-app"
  },
  "author": {
    "name": "Teros Team",
    "email": "team@teros.ai"
  },
  "availability": {
    "enabled": true,
    "multi": false,
    "system": false,
    "hidden": false,
    "role": "user"
  },
  "systemSecrets": ["ACCOUNT_SID", "AUTH_TOKEN"],
  "userSecrets": ["ACCOUNT_SID", "AUTH_TOKEN"],
  "auth": {
    "type": "api-key",
    "provider": "twilio"
  },
  "keywords": ["twilio", "sms", "phone", "calls", "telephony", "messaging", "communication"],
  "layers": {
    "tools": true,
    "events": false,
    "ui": false,
    "permissions": false,
    "auth": {
      "type": "api-key",
      "systemSecrets": ["ACCOUNT_SID", "AUTH_TOKEN"],
      "userSecrets": ["ACCOUNT_SID", "AUTH_TOKEN"]
    },
    "agent": false
  },
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-10-18",
      "notes": "Initial release — manage Twilio phone numbers, send SMS, browse message/call history, and monitor account balance"
    }
  ]
}
