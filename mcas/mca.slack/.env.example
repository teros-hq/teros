# Slack MCA - Environment Variables
#
# For testing, add these credentials to packages/mca-testing/.env.test
#
# System secrets (configured by admin):
# CLIENT_ID=your-slack-oauth-client-id
# CLIENT_SECRET=your-slack-oauth-client-secret
# REDIRECT_URIS=["https://your-domain/api/oauth/callback"]
#
# User secrets (set via OAuth flow):
# ACCESS_TOKEN=xoxp-user-access-token
# BOT_ACCESS_TOKEN=xoxb-bot-access-token
# REFRESH_TOKEN=user-refresh-token
# TEAM_ID=T0123456789
# TEAM_NAME=your-workspace
# USER_ID=U0123456789
