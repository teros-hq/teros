{
  "$schema": "https://teros.ai/schemas/mca-manifest.json",
  "id": "mca.teros.board-manager",
  "name": "Board Manager",
  "version": "2.0.0",
  "description": "Full board management capabilities for coordinator and supervisor agents. Provides complete control over projects, boards, and tasks — including creating, assigning, updating, moving, and deleting tasks. Designed for agents that orchestrate work across multiple workers, manage priorities, and oversee the full lifecycle of a project board.",
  "type": "system",
  "icon": "icon.svg",
  "category": "productivity",
  "entrypoint": "./src/index.ts",
  "author": {
    "name": "Alice Evergreen",
    "email": "alice@teros.ai"
  },
  "availability": {
    "enabled": true,
    "multi": false,
    "system": true,
    "hidden": true,
    "role": "user"
  },
  "systemSecrets": [],
  "runtime": {
    "transport": "http",
    "containerMode": "per-app"
  },
  "keywords": [
    "boards",
    "projects",
    "tasks",
    "kanban",
    "manager",
    "coordinator",
    "orchestrator"
  ],
  "layers": {
    "tools": true,
    "events": true,
    "ui": false,
    "permissions": false,
    "auth": false,
    "agent": false
  },
  "changelog": [
    {
      "version": "2.0.0",
      "date": "2026-03-01",
      "notes": "Create and organize projects and Kanban boards, manage tasks and dependencies, assign agents, and orchestrate autonomous work"
    }
  ],
  "events": [
    {
      "topic": "board.task_created",
      "description": "A task was created on a board.",
      "payload": {
        "workspaceId": "string",
        "projectId": "string",
        "boardId": "string",
        "taskId": "string",
        "taskTitle": "string",
        "actor": "string (userId or agentId)",
        "occurredAt": "ISO date",
        "agentId": "string",
        "channelId": "string"
      }
    },
    {
      "topic": "board.task_moved",
      "description": "A task changed column.",
      "payload": {
        "workspaceId": "string",
        "projectId": "string",
        "boardId": "string",
        "taskId": "string",
        "taskTitle": "string",
        "actor": "string (userId or agentId)",
        "occurredAt": "ISO date",
        "fromColumn": "string",
        "toColumn": "string",
        "fromColumnName": "string",
        "toColumnName": "string",
        "fromStatus": "string",
        "toStatus": "string"
      }
    },
    {
      "topic": "board.task_assigned",
      "description": "A task was assigned to an agent.",
      "payload": {
        "workspaceId": "string",
        "projectId": "string",
        "boardId": "string",
        "taskId": "string",
        "taskTitle": "string",
        "actor": "string (userId or agentId)",
        "occurredAt": "ISO date",
        "agentId": "string"
      }
    },
    {
      "topic": "board.task_unassigned",
      "description": "A task lost its assignee.",
      "payload": {
        "workspaceId": "string",
        "projectId": "string",
        "boardId": "string",
        "taskId": "string",
        "taskTitle": "string",
        "actor": "string (userId or agentId)",
        "occurredAt": "ISO date",
        "agentId": "string"
      }
    },
    {
      "topic": "board.task_started",
      "description": "An agent started working on a task.",
      "payload": {
        "workspaceId": "string",
        "projectId": "string",
        "boardId": "string",
        "taskId": "string",
        "taskTitle": "string",
        "actor": "string (userId or agentId)",
        "occurredAt": "ISO date",
        "agentId": "string",
        "channelId": "string"
      }
    },
    {
      "topic": "board.task_completed",
      "description": "A task was completed.",
      "payload": {
        "workspaceId": "string",
        "projectId": "string",
        "boardId": "string",
        "taskId": "string",
