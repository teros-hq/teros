{
  "$schema": "https://teros.ai/schemas/mca-manifest.json",
  "id": "mca.teros.admin.filesystem",
  "name": "Filesystem (Admin)",
  "version": "2.1.0",
  "description": "Filesystem operations on host machine. Admin only. Same surface as mca.teros.filesystem but without workspace jail.",
  "type": "utility",
  "icon": "icon.svg",
  "category": "development",
  "entrypoint": "src/index.ts",
  "runtime": {
    "transport": "stdio"
  },
  "author": {
    "name": "Alice Evergreen",
    "email": "alice@teros.ai"
  },
  "availability": {
    "enabled": true,
    "multi": false,
    "system": false,
    "hidden": false,
    "role": "admin"
  },
  "keywords": ["files", "filesystem", "read", "write", "edit", "patch", "search", "grep", "host"],
  "layers": {
    "tools": true,
    "events": false,
    "ui": false,
    "permissions": false,
    "auth": false,
    "agent": false
  },
  "changelog": [
    {
      "version": "2.1.0",
      "date": "2026-04-30",
      "notes": "Read, write, edit and patch files, search by name and content, and manage folders across the host machine"
    }
  ]
}
