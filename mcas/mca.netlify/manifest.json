{
  "$schema": "https://teros.ai/schemas/mca-manifest.json",
  "id": "mca.netlify",
  "name": "Netlify",
  "version": "1.0.0",
  "description": "Deploy static sites (HTML/CSS/JS) from the workspace to Netlify and return the public URL. Uses the file-digest REST API with a per-user Personal Access Token.",
  "type": "integration",
  "icon": "icon.png",
  "category": "development",
  "entrypoint": "src/index.ts",
  "author": {
    "name": "Teros Team",
    "email": "team@teros.ai"
  },
  "availability": {
    "enabled": true,
    "multi": false,
    "system": false,
    "hidden": false,
    "role": "user"
  },
  "runtime": {
    "transport": "http",
    "containerMode": "per-app"
  },
  "keywords": ["netlify", "deploy", "static site", "hosting", "cdn", "web"],
  "layers": {
    "tools": true,
    "events": false,
    "ui": false,
    "permissions": true,
    "auth": {
      "type": "api-key",
      "userSecrets": ["NETLIFY_TOKEN"]
    },
    "agent": false
  }
}
