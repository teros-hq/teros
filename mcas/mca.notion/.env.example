# Notion MCA - Environment Variables
#
# For testing, add these credentials to packages/mca-testing/.env.test
#
# System secrets (configured by admin):
# CLIENT_ID=your-notion-oauth-client-id
# CLIENT_SECRET=your-notion-oauth-client-secret
#
# User secrets (set via OAuth flow):
# ACCESS_TOKEN=user-access-token
# REFRESH_TOKEN=user-refresh-token
# EXPIRY_DATE=token-expiry-timestamp
