{
  "$schema": "https://teros.ai/schemas/mca-manifest.json",
  "id": "mca.github",
  "name": "GitHub",
  "version": "5.1.0",
  "description": "GitHub repository management + local git development environment - repos, issues, pull requests, actions, commits, branches, releases, plus local git operations on cloned repos (status/add/commit/push/checkout). Auth via the Teros GitHub App with user-to-server OAuth (each user actúa con su propia identidad de GitHub).",
  "type": "integration",
  "icon": "icon.svg",
  "category": "development",
  "entrypoint": "src/index.ts",
  "author": {
    "name": "Teros Team",
    "email": "team@teros.ai"
  },
  "availability": {
    "enabled": true,
    "multi": true,
    "system": false,
    "hidden": false,
    "role": "user"
  },
  "layers": {
    "tools": true,
    "events": false,
    "ui": false,
    "permissions": false,
    "auth": {
      "type": "github-app",
      "provider": "github",
      "appSlug": "teros-ai-prod",
      "setupUrl": "https://be.teros.ai/auth/mca/callback?provider=github-app",
      "userOAuth": true,
      "tokenUrl": "https://github.com/login/oauth/access_token",
      "permissions": {
        "contents": "write",
        "issues": "write",
        "pull_requests": "write",
        "metadata": "read",
        "workflows": "write",
        "actions": "write",
        "checks": "write",
        "members": "read",
        "administration": "read"
      },
      "events": ["installation", "installation_repositories"],
      "systemSecrets": [
        "GITHUB_APP_ID",
        "GITHUB_APP_CLIENT_ID",
        "GITHUB_APP_CLIENT_SECRET",
        "GITHUB_APP_PRIVATE_KEY",
        "GITHUB_APP_WEBHOOK_SECRET",
        "GITHUB_APP_SLUG"
      ],
      "userSecrets": [
        "INSTALLATION_ID",
        "USER_ACCESS_TOKEN",
        "USER_REFRESH_TOKEN",
        "USER_TOKEN_EXPIRES_AT",
        "USER_LOGIN"
      ]
    },
    "agent": false
  },
  "runtime": {
    "transport": "http",
    "containerMode": "per-app",
    "port": 3000,
    "healthCheck": "/health"
  },
  "keywords": ["github", "git", "repositories", "issues", "pull-requests", "ci-cd", "actions", "github-app", "local-development"],
  "changelog": [
    {
      "version": "5.1.0",
      "date": "2026-05-13",
      "notes": "Manage repos, issues, pull requests and reviews, run Actions and releases, plus full local git on cloned repos"
    }
  ]
}
