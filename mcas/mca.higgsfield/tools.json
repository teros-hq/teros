{
  "$schema": "https://teros.ai/schemas/mca-tools.json",
  "mcaId": "mca.higgsfield",
  "tools": [
    {
      "name": "-health-check",
      "description": "Internal health check tool. Verifies Higgsfield API credentials and connectivity.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "higgsfield-run",
      "description": "Run any model on Higgsfield. Supports text-to-image, image-to-video, and other AI generation models. Image/video inputs inside `input` must be PUBLIC URLs (https://...) or data: URIs — Higgsfield cannot reach internal/localhost URLs. Internal Teros objects URLs (http://localhost:.../objects/obj_... or http://127.0.0.1:.../objects/obj_...) are automatically resolved to data URIs (objects up to 10 MB).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "Model/endpoint identifier (e.g., 'higgsfield-ai/soul/standard'). Run higgsfield-list-models to see what's available."
          },
          "input": {
            "type": "object",
            "description": "Input parameters for the model"
          },
          "wait": {
            "type": "boolean",
            "description": "Wait for completion (default: false)",
            "default": false
          }
        },
        "required": [
          "model",
          "input"
        ]
      },
      "annotations": {
        "readOnlyHint": false
      }
    },
    {
      "name": "higgsfield-text-to-image",
      "description": "Generate images from text prompts using Higgsfield Soul Standard (ultra-realistic fashion/portrait).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Text description of the image to generate"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "720p",
              "1080p"
            ],
            "default": "1080p",
            "description": "Output resolution"
          },
          "aspect_ratio": {
            "type": "string",
            "enum": [
              "1:1",
              "16:9",
              "9:16",
              "4:3",
              "3:4",
              "21:9",
              "9:21"
            ],
            "default": "16:9",
            "description": "Aspect ratio of the generated image"
          },
          "style": {
            "type": "string",
            "description": "Optional style preset"
          },
          "wait": {
            "type": "boolean",
            "description": "Wait for completion (default: false)",
            "default": false
          }
        },
        "required": [
          "prompt"
        ]
      },
      "annotations": {
        "readOnlyHint": false
      }
    },
    {
      "name": "higgsfield-text-to-video",
      "description": "Generate video from text prompt using WAN v2.6.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Text description of the video to generate"
          },
          "duration": {
            "type": "number",
            "default": 5,
            "description": "Video duration in seconds (default: 5)"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "720p",
              "1080p"
            ],
            "default": "1080p",
            "description": "Output resolution"
          },
          "aspect_ratio": {
            "type": "string",
            "enum": [
              "16:9",
              "9:16",
              "1:1"
            ],
            "default": "16:9",
            "description": "Aspect ratio"
          },
          "wait": {
            "type": "boolean",
            "description": "Wait for completion (default: false)",
            "default": false
          }
        },
        "required": [
          "prompt"
        ]
      },
      "annotations": {
        "readOnlyHint": false
      }
    },
    {
      "name": "higgsfield-soul-generate",
      "description": "Generate images with consistent character appearance using Soul. Great for creating multiple images of the same character.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Text description of the scene/pose for the character"
          },
          "reference_image": {
            "type": "string",
            "description": "URL of the reference image for character consistency. Must be a PUBLIC URL (https://...) or data: URI — internal/localhost URLs are auto-resolved to data URIs (up to 10 MB)."
          },
          "style": {
            "type": "string",
            "description": "Optional style preset"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "720p",
              "1080p"
            ],
            "default": "1080p"
          },
          "wait": {
            "type": "boolean",
            "description": "Wait for completion (default: false)",
            "default": false
          }
        },
        "required": [
          "prompt",
          "reference_image"
        ]
      },
      "annotations": {
        "readOnlyHint": false
      }
    },
    {
      "name": "higgsfield-get-prediction",
      "description": "Get the status and result of a prediction by ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prediction_id": {
            "type": "string",
            "description": "The prediction ID to check"
          },
          "wait": {
            "type": "boolean",
            "default": false,
            "description": "Wait for completion if still processing (default: false)"
          }
        },
        "required": [
          "prediction_id"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "higgsfield-cancel-prediction",
      "description": "Cancel a queued or processing prediction.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prediction_id": {
            "type": "string",
            "description": "The prediction ID to cancel"
          }
        },
        "required": [
          "prediction_id"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "irreversible": true
      }
    },
    {
      "name": "higgsfield-list-models",
      "description": "List available models and their capabilities.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "all",
              "text-to-image",
              "image-to-video",
              "text-to-video",
              "image-to-image"
            ],
            "default": "all",
            "description": "Filter models by type"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    }
  ]
}
