      }
    },
    {
      "name": "approve-overtime",
      "description": "Approve an overtime request by ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "overtimeRequestId": {
            "type": "number",
            "description": "The overtime request ID to approve"
          }
        },
        "required": [
