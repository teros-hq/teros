# TerOS - Environment Variables
#
# Copy this to .env and fill in the values for your environment.
# Only infrastructure config goes here. All secrets (API keys, DB credentials)
# are managed in .secrets/ — see .secrets/README.md.

# === Server ===
PORT=10001                         # Backend server port (local dev). Docker Compose overrides this to 3000 internally and maps it to host :10001.
APP_URL=http://localhost:10002      # Frontend app URL — OAuth redirects and the CORS allowlist (required)
# CORS_ALLOWED_ORIGINS=https://other.example   # Extra web origins allowed to call the API with credentials
                                                # (comma-separated). The origin of APP_URL is always allowed.
# BIND_HOST=127.0.0.1              # Restrict the HTTP/WS listener to loopback. Unset = all interfaces
                                    # (required so MCA containers reach the core via host.docker.internal).
                                    # Only set this if you are NOT running MCAs, or you are certain nothing
                                    # else needs to reach this port directly — otherwise MCA tool calls fail.
# TRUST_PROXY=true                 # REQUIRED=true when this server sits behind a reverse proxy
#                                  # (also required for the /metrics IP allowlist to work in production;
#                                  #  without it /metrics answers 403 unless METRICS_TOKEN is sent)
# METRICS_TOKEN=                   # optional bearer token that opens /metrics from anywhere (canary / scraper)
                                    # (nginx/Traefik). Default false. With false behind a proxy, every
                                    # request appears to come from the proxy's IP: the per-IP rate limiter
                                    # buckets ALL traffic together, and if the proxy's IP falls in
                                    # METRICS_ALLOWED_IPS (default loopback + RFC1918, which a same-host
                                    # nginx usually does), /metrics becomes PUBLICLY reachable through the
                                    # proxy. Never set true on a directly exposed port — XFF becomes spoofable.

# === MCA Configuration ===
# Docker Compose sets this to the in-container path automatically. For LOCAL dev
# (running the container-agent on the host), set an ABSOLUTE host path to this repo's
# mcas/ directory, e.g. MCA_BASE_PATH=/absolute/path/to/teros/mcas
MCA_BASE_PATH=/app/mcas            # Path to MCAs directory
# MCA_MAX_CONTAINERS=250           # Hard cap on concurrent MCA containers (spawns beyond it fail fast)
# MCA_IDLE_TIMEOUT_MS=600000       # Stop containers idle longer than this (default 30 min)
# MCA_CONTAINER_CPUS=1             # Default --cpus per MCA container (0 = unlimited; manifest runtime.resources overrides)
# MCA_CONTAINER_MEMORY_MB=1024     # Default --memory per MCA container in MiB (0 = unlimited)

# === Container agent (REQUIRED; TWO-HOST-SEPARATION-PLAN.md) ===
# All Docker operations go through the teros-container-agent pm2 app — the core
# has no direct Docker path (CONTAINER_PROVIDER defaults to 'remote'; 'docker'
# was removed 2026-07-05; 'kubernetes' is parked for a possible GKE future).
CONTAINER_AGENT_TOKEN=             # Shared bearer token (generate: openssl rand -hex 32); required by both sides
# CONTAINER_AGENT_URL=http://127.0.0.1:10011
# CONTAINER_AGENT_PORT=10011       # Agent listen port
# CONTAINER_AGENT_HOST=127.0.0.1   # Agent listen interface — loopback or private only, NEVER public
# AGENT_ID=                        # Agent identity in /health & /v1/status (default: hostname)
# --- Remote execution machine only (phase 2; unset = same-machine behavior) ---
# CONTAINER_AGENT_ADVERTISE_HOST=  # Agent side: host written into baseUrl so the core reaches containers (agent machine's private IP)
#                                  # macOS LOCAL DEV (hybrid mode, agent on the host): set it to 127.0.0.1. Docker Desktop
#                                  # does not route container bridge IPs (172.x) from the host, so without it every MCA
#                                  # fails with "did not become healthy within 60000ms". Not needed on Linux.
# MCA_CALLBACK_HOST=               # Both sides: host containers use to call the core back (core machine's private IP)
# MCA_MONGODB_URI=                 # MONGODB_URI injected into containers (e.g. mongodb://<core-private-ip>:27017) — overrides the localhost→mongodb rewrite

# === Datastores (datastore-isolation P0b — Mongo auth + Qdrant API key) ===
# Only needed once the opt-in override is applied:
#   docker compose -f docker-compose.yml -f docker-compose.auth.yml up -d
# (then required, `:?`; to make it permanent set
#  COMPOSE_FILE=docker-compose.yml:docker-compose.auth.yml).
# Two Mongo users by ROLE (no per-MCA credentials: no MCA connects to Mongo any more):
MONGO_ROOT_USER=root               # Enables --auth in the official image
MONGO_ROOT_PASSWORD=                # openssl rand -hex 32
MONGO_RW_USER=teros_rw             # readWrite on `teros` → the backend
MONGO_RW_PASSWORD=                  # openssl rand -hex 32
MONGO_RO_USER=teros_ro             # read on `teros` → ops / reporting
MONGO_RO_PASSWORD=                  # openssl rand -hex 32
QDRANT_API_KEY=                     # openssl rand -hex 32; MUST equal qdrantApiKey in .secrets/mcas/mca.teros.memory/credentials.json
# Backend outside compose (pm2 on the host): set MONGODB_URI to
#   mongodb://teros_rw:<MONGO_RW_PASSWORD>@127.0.0.1:27017/teros?authSource=admin
# (or put it in the `database` system secret) and make the memory credentials'
# qdrantUrl host-reachable (http://127.0.0.1:6333), not the Docker name.

# === Data-layer schema validation (docs/architecture/validacion-esquemas.md) ===
# Writes to collections with a schema (users, workspaces, billing_*) that do
# not match it: warn = log a warning and write anyway (default); error = throw
# and do not write. Reads that do not match always just log a warning.
# DB_SCHEMA_WRITES=warn

# === Static Files URL ===
# Local dev: keep this in sync with PORT above (the built-in default is :3000,
# which would mismatch the backend on :10001). Docker Compose sets it to :10001 itself.
STATIC_BASE_URL=http://localhost:10001/static
# Production: STATIC_BASE_URL=https://your-domain/static

# === Image upload allowlist (LLM vision pipeline) ===
# Comma-separated hostnames where user-uploaded images are served from.
# When unset, defaults to the hostname of STATIC_BASE_URL — set this explicitly
# only if uploads live on a different origin than the static server (CDN, S3,
# separate file service). Required for the LLM image pipeline to accept URLs.
# TEROS_FILE_DOMAIN=your-domain.com,cdn.your-domain.com

# === Docker images ===
# Every release publishes ghcr.io/teros-hq/teros-backend and teros-frontend.
# `docker compose pull` fetches this tag (default: latest); pin a version to
# stay on it: TEROS_IMAGE_TAG=1.4.7. `docker compose up --build` ignores it
# and builds from the working tree instead.
# TEROS_IMAGE_TAG=latest

# === Frontend Configuration ===
# Where the web app finds the backend. With `docker compose` these are RUNTIME
# values: the frontend container writes them to /config.js when it starts, so a
# change only needs `docker compose up -d frontend`, not a rebuild. For Metro
# (`expo start`) and native builds they are still read at build time.
# Leave both empty when the web and the backend share an origin (reverse proxy).
# Defaults below work for a local `docker compose up`; change to your domain for production.
EXPO_PUBLIC_WS_URL=ws://localhost:10001/ws
EXPO_PUBLIC_BACKEND_URL=http://localhost:10001

# === Docker Environments MCA (optional) ===
# Base domain for ephemeral docker environments (e.g. abc123.envs.yourdomain.com)
# Requires a wildcard DNS record *.envs.yourdomain.com → your server IP
# and a valid SSL cert for that wildcard domain
# DOCKER_ENV_DOMAIN=envs.yourdomain.com
# Host path where workspace volumes are stored on the machine running Docker
# This is needed so the Docker daemon can resolve workspace bind mounts correctly
# WORKSPACE_HOST_PATH=/data/volumes/users

# === Agent Apps Storage (optional) ===
# Base path for Agent Apps object storage (filesystem objects uploaded by agent apps).
# Configurable so deployments can point at a mounted volume.
# AGENT_APPS_OBJECT_STORAGE_PATH=/data/agent-apps-objects

# === Sentry (optional) ===
# Set up your own Sentry project at https://sentry.io
# If not set, error tracking is disabled
# SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
# EXPO_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project

# === Datadog LLM / Agent Observability (optional, backend) ===
# Instruments the backend's LLM calls (Anthropic + OpenAI SDKs) with Datadog
# LLM Observability via dd-trace. The loader is wired in through
# NODE_OPTIONS="--import dd-trace/initialize.mjs" in the backend startup commands,
# so these vars must be present in the process env at spawn time (PM2 injects
# them from the deploy .env on the host). If DD_LLMOBS_ENABLED is unset,
# instrumentation is a no-op.
# DD_SITE=datadoghq.eu                  # datadoghq.com (default), datadoghq.eu, us3/us5, etc.
# DD_API_KEY=<your-datadog-api-key>     # secret — keep out of source control
# DD_LLMOBS_ENABLED=true                # turn LLM Observability on
# DD_LLMOBS_AGENTLESS_ENABLED=true      # send directly to Datadog (no local agent)
# DD_LLMOBS_ML_APP=teros                # application name shown in Datadog

# =============================================================================
# Edition (TER-EDITION) — deployment mode, see docs/providers/20261101_teros-editions-deployment-matrix.md
# =============================================================================
# 'self-hosted' (default) = open-source/downloadable build; the local Ollama
# provider (daemon on the backend host) is available.
# 'cloud' = Teros-hosted deployment (RAW, production); the local Ollama provider
# is hidden and refused — use 'ollama-cloud' (hosted API) instead.
# Backend reads TEROS_EDITION; the app reads EXPO_PUBLIC_TEROS_EDITION at build time.
# TEROS_EDITION=self-hosted
# EXPO_PUBLIC_TEROS_EDITION=self-hosted
