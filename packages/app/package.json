{
  "name": "@teros/app",
  "version": "2.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "npx expo export --platform web --output-dir dist --clear && node scripts/inject-pwa.js",
    "build:terminal": "cd src/terminal-bundle && bun run build",
    "typecheck": "tsc --noEmit",
    "test:render": "vitest run",
    "validate:colors": "bun scripts/validate-color-contrast.ts",
    "eas-build-post-install": "yarn workspace @teros/shared build"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@native-html/table-plugin": "^5.3.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "^7.8.0",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@tamagui/animations-react-native": "1.138.6",
    "@tamagui/config": "1.138.6",
    "@tamagui/lucide-icons": "1.138.6",
    "@tamagui/toast": "1.138.6",
    "@teros/mca-bash": "*",
    "@teros/shared": "*",
    "burnt": "^0.13.0",
    "expo": "~54.0.29",
    "expo-audio": "^1.1.0",
    "expo-av": "~16.0.8",
    "expo-constants": "~18.0.12",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.10",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-localization": "^55.0.13",
    "expo-router": "6.0.19",
    "expo-secure-store": "~15.0.1",
    "expo-status-bar": "~3.0.9",
    "i18next": "^26.1.0",
    "marked": "^17.0.1",
    "phosphor-react-native": "^3.0.6",
    "posthog-react-native": "^4.53.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.7",
    "react-native": "0.81.5",
    "react-native-code-highlighter": "^1.3.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "^4.2.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "^0.7.4",
    "react-syntax-highlighter": "^16.1.0",
    "recordrtc": "^5.6.2",
    "tamagui": "1.138.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "~19.1.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/recordrtc": "^5.6.15",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "vitest": "^3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": false,
        "exclude": [
          "@expo/vector-icons",
          "expo",
          "expo-constants",
          "expo-font",
          "expo-linking"
        ]
      }
    }
  },
  "private": true
}
