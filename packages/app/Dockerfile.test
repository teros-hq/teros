# syntax=docker/dockerfile:1.7-labs
# Multi-stage build for Teros Frontend
# Stage 1: Build the app with Node/Yarn
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS builder

WORKDIR /app

# node-pty (dependencia transitiva vía xterm/terminal) se compila con node-gyp y necesita
# Python + toolchain en Alpine. Sin esto, `yarn install` peta con "Could not find any Python
# installation to use". El Dockerfile.browser ya lo hace; lo replicamos aquí. TER-553.
RUN apk add --no-cache python3 make g++

# Build arguments for environment variables (injected at build time)
# These MUST be provided — no defaults to prevent accidental production usage
ARG EXPO_PUBLIC_WS_URL
ARG EXPO_PUBLIC_BACKEND_URL

# Set as environment variables for the build
ENV EXPO_PUBLIC_WS_URL=$EXPO_PUBLIC_WS_URL
ENV EXPO_PUBLIC_BACKEND_URL=$EXPO_PUBLIC_BACKEND_URL

# Validate required build args (no depende del código → antes para fallar rápido)
RUN if [ -z "$EXPO_PUBLIC_WS_URL" ]; then echo "ERROR: EXPO_PUBLIC_WS_URL is required" && exit 1; fi && \
    if [ -z "$EXPO_PUBLIC_BACKEND_URL" ]; then echo "ERROR: EXPO_PUBLIC_BACKEND_URL is required" && exit 1; fi

# Layer caching (TER-548): manifests → install → código. El builder es multi-stage (la imagen
# final es nginx + dist/), así que NO necesita `yarn cache clean` — el cache del builder no llega
# a la imagen final. COPY --parents (1.7-labs) preserva la estructura de dirs de los globs.
# yarn workspaces necesita TODOS los package.json (packages/* + mcas/*) para resolver.
# mcas/*/*.tgz: deps vendorizadas `file:./x.tgz` (p.ej. @teros/ocr en file-processor) — sin ellas
# `yarn install --frozen-lockfile` falla con "Tarball is not in network".
COPY --parents package.json yarn.lock packages/*/package.json mcas/*/package.json mcas/*/*.tgz ./
# GITHUB_TOKEN via secret mount (NO queda en ninguna capa): @vscode/ripgrep (dep transitiva) y
# otras deps descargan binarios de GitHub en su postinstall; sin token GitHub limita a 60 req/h
# → 504. Con el token de Actions, 1000 req/h. TER-553.
RUN --mount=type=secret,id=github_token \
    GITHUB_TOKEN="$(cat /run/secrets/github_token 2>/dev/null || true)" \
    yarn install --frozen-lockfile --ignore-engines --network-timeout 600000
COPY . .

# Build @teros/shared first (generates dist/ needed by the app)
WORKDIR /app/packages/shared
RUN npx tsc --build

# Build @teros/workflows too (app imports it — main/types resolve from dist/,
# same gap as 519e9a0da fixed in the production Dockerfile)
WORKDIR /app/packages/workflows
RUN npx tsc --build

# Build the web app
WORKDIR /app/packages/app
# Same heap fix as the production Dockerfile (765b2e6da): expo export with
# 43 React.lazy window imports OOMs on the default 4GB Node heap.
ENV NODE_OPTIONS="--max-old-space-size=8192"
RUN yarn build

# Stage 2: Serve with nginx
FROM nginx:alpine@sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752

# Copy nginx config
COPY packages/app/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built app from builder stage
COPY --from=builder /app/packages/app/dist /usr/share/nginx/html

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
