{
  "name": "@teros/shared",
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./memory": {
      "bun": "./src/memory/index.ts",
      "import": "./dist/memory/index.js",
      "types": "./dist/memory/index.d.ts"
    },
    "./memory/*": {
      "bun": "./src/memory/*.ts",
      "import": "./dist/memory/*.js",
      "types": "./dist/memory/*.d.ts"
    },
    "./memory/conversation": {
      "bun": "./src/memory/conversation.ts",
      "import": "./dist/memory/conversation.js",
      "types": "./dist/memory/conversation.d.ts"
    },
    "./memory/knowledge": {
      "bun": "./src/memory/knowledge.ts",
      "import": "./dist/memory/knowledge.js",
      "types": "./dist/memory/knowledge.d.ts"
    },
    "./memory/importance": {
      "bun": "./src/memory/importance.ts",
      "import": "./dist/memory/importance.js",
      "types": "./dist/memory/importance.d.ts"
    },
    "./memory/types": {
      "bun": "./src/memory/types.ts",
      "import": "./dist/memory/types.js",
      "types": "./dist/memory/types.d.ts"
    },
    "./evaluator": {
      "bun": "./src/evaluator/index.ts",
      "import": "./dist/evaluator/index.js",
      "types": "./dist/evaluator/index.d.ts"
    },
    "./markdown": {
      "types": "./src/markdown/index.ts",
      "bun": "./src/markdown/index.ts",
      "browser": "./src/markdown/index.ts",
      "react-native": "./src/markdown/index.ts",
      "import": "./dist/markdown/index.js",
      "require": "./dist/markdown/index.js",
      "default": "./dist/markdown/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "generate-icons": "bun run scripts/generate-lucide-icons.ts"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.12.0",
    "marked": "^17.0.1",
    "openai": "^4.0.0",
    "uuid": "^11.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.10.1",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.2"
  }
}
