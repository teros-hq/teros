# ─────────────────────────────────────────────────────────────────────────────
# MCA Integration Test Credentials
#
# Copy to .env.test and fill in real values.
# .env.test is gitignored — never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Memory MCA ──────────────────────────────────────────────────────────────
# Real OpenAI key for embedding generation (text-embedding-3-small)
OPENAI_API_KEY=sk-...

# ── Gmail MCA ───────────────────────────────────────────────────────────────
# Google OAuth app credentials (from Google Cloud Console)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URIS=http://localhost/callback

# OAuth tokens for a test Google account
GMAIL_ACCESS_TOKEN=
GMAIL_REFRESH_TOKEN=
GMAIL_EMAIL=your-test-account@gmail.com

# ── Slack MCA ──────────────────────────────────────────────────────────────
# Slack OAuth app credentials (from api.slack.com/apps)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URIS=http://localhost/callback

# OAuth tokens for a test Slack workspace
SLACK_ACCESS_TOKEN=xoxp-...
SLACK_BOT_ACCESS_TOKEN=xoxb-...
SLACK_REFRESH_TOKEN=
SLACK_TEAM_ID=T0123456789
SLACK_USER_ID=U0123456789

# ── Notion MCA ─────────────────────────────────────────────────────────────
# Notion OAuth app credentials (from developers.notion.com)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# OAuth tokens for a test Notion workspace
NOTION_ACCESS_TOKEN=
NOTION_REFRESH_TOKEN=
