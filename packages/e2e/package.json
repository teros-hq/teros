  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "NODE_OPTIONS='--import tsx/esm' cucumber-js --exit",
    "e2e:ws": "NODE_OPTIONS='--import tsx/esm' cucumber-js --tags '@smoke or @auth or @channels or @messaging' --exit",
    "e2e:ui": "NODE_OPTIONS='--import tsx/esm' cucumber-js --config cucumber.ui.cjs --exit",
    "e2e:sanity": "NODE_OPTIONS='--import tsx/esm' cucumber-js --config cucumber.sanity.cjs --exit",
    "seed": "tsx src/scripts/seed-test-data.ts",
    "seed:ui": "tsx src/scripts/seed-ui-users.ts"
  },
  "dependencies": {
    "@cucumber/cucumber": "^12.4.0",
    "@teros/core": "*",
    "@teros/shared": "*",
    "@teros/testing": "*",
    "bcrypt": "^5.1.1",
    "chai": "^6.2.2",
    "mongodb": "^6.11.0",
    "playwright": "^1.52.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/chai": "^5.2.3",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
