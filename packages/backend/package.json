{
  "name": "@teros/backend",
  "version": "2.0.0",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--import dd-trace/initialize.mjs\" tsx watch src/index.ts",
    "dev:container-agent": "tsx watch src/container-agent.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "yarn sync && NODE_OPTIONS=\"--import dd-trace/initialize.mjs\" tsx src/index.ts",
    "sync": "tsx src/scripts/sync-mca-static.ts && tsx src/scripts/sync-mcas.ts && tsx src/scripts/sync-models.ts",
    "gen-tools": "tsx ../../scripts/generate-mca-tools.ts",
    "seed": "tsx src/scripts/seed-agents.ts",
    "dev:seed": "tsx src/scripts/dev-seed.ts",
    "sync-mcas": "tsx src/scripts/sync-mcas.ts",
    "sync-mcas:dry": "tsx src/scripts/sync-mcas.ts --dry-run",
    "sync-models": "tsx src/scripts/sync-models.ts",
    "sync-models:dry": "tsx src/scripts/sync-models.ts --dry-run",
    "check-models": "tsx src/scripts/check-model-updates.ts",
    "test": "bun test tests/",
    "test:claude-creds": "tsx src/scripts/test-claude-code-credentials.ts",
    "oauth:login": "tsx src/scripts/claude-oauth-login.ts",
    "oauth:status": "tsx src/scripts/test-claude-code-credentials.ts",
    "reseed-permissions": "tsx src/scripts/reseed-tool-permissions.ts",
    "reseed-permissions:dry": "tsx src/scripts/reseed-tool-permissions.ts --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@kubernetes/client-node": "^1.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@sentry/node": "^10.32.1",
    "@teros/core": "*",
    "@teros/shared": "*",
    "@teros/workflows": "*",
    "bcrypt": "^6.0.0",
    "chrono-node": "^2.7.7",
    "croner": "^9.1.0",
    "dd-trace": "^5.110.0",
    "dotenv": "^16.4.7",
    "google-auth-library": "^10.3.0",
    "mongodb": "^6.11.0",
    "node-pty": "^1.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "pngjs": "^3.3.0",
    "resend": "^6.9.1",
    "sharp": "^0.35.5",
    "stripe": "^22.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@teros/testing": "*",
    "@types/node": "^22.10.1",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
