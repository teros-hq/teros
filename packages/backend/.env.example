# TerOS Backend - Environment Variables
#
# Only infrastructure config goes here.
# All secrets (API keys, DB credentials) are managed in .secrets/
# See .secrets/README.md for details.

# Server Configuration
PORT=3001

# MCA Configuration (Required for tool execution)
# Absolute path to the mcas directory
MCA_BASE_PATH=/absolute/path/to/teros/mcas

# Uploads Configuration (Optional - defaults to ./uploads)
UPLOADS_PATH=./uploads

# Static Files URL (Optional - defaults to http://localhost:3000/static)
# STATIC_BASE_URL=https://your-domain/static

# Image upload allowlist (Optional)
# Comma-separated hostnames accepted by the LLM image pipeline. When unset,
# defaults to the hostname of STATIC_BASE_URL. Set this explicitly only if
# uploaded images are served from a different origin than the static server.
# TEROS_FILE_DOMAIN=your-domain.com

# Base domain for docker-env ephemeral environments
DOCKER_ENV_DOMAIN=envs.teros.ai

# Agent usage instrumentation (TER-349)
# All optional with sensible defaults — see docs/usage-instrumentation.md §13.
# Identity of this process for leader election and /metrics labels.
# If unset, resolved as ${HOSTNAME}-${pid}, then os.hostname()-${pid}, then random.
# INSTANCE_ID=
# Cuts off emission in handlers/tools (rollback flag — default true)
# AGENT_USAGE_INSTRUMENTATION_ENABLED=true
# Cuts off reconciler + rollup job (independent rollback)
# AGENT_USAGE_BACKGROUND_JOBS_ENABLED=true
