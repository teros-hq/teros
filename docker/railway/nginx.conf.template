# Teros all-in-one (Railway): static frontend + reverse proxy to the backend.
# __PORT__ is replaced by the entrypoint with the Railway-provided $PORT.
# The backend listens on 127.0.0.1:3000 (BACKEND_PORT).

# Canonical WebSocket upgrade handling (http-level directive)
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Railway terminates TLS at its edge and speaks HTTP to the container, so
# $scheme is always 'http' here. Pass through the edge's X-Forwarded-Proto
# (https) and default to https when absent (direct edge traffic is always TLS).
map $http_x_forwarded_proto $upstream_proto {
    default $http_x_forwarded_proto;
    ''      https;
}

server {
    listen __PORT__;
    server_name _;

    # Static frontend root (Expo web export copied by the Dockerfile).
    # REQUIRED: without this, nginx falls back to the Alpine compile-time
    # default root (the welcome page directory) and try_files serves the
    # wrong index.html — the exact bug seen on the first Railway deploy.
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json image/svg+xml;

    # File uploads (audio, images) — must match the backend's own limit
    client_max_body_size 50m;

    # ── WebSocket endpoints ────────────────────────────────────────────────
    # /ws (app clients), /voice (voice sessions), /mca (MCA runtime connections)
    location ~ ^/(ws|voice|mca)(/|$) {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $upstream_proto;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ── Backend HTTP paths ─────────────────────────────────────────────────
    # Every prefix the backend serves (packages/backend/src/bootstrap/http-server.ts):
    # /static, /mca/callback, /webhooks, /auth, /api, /media, /share, /objects,
    # /g2, /terminal, /admin, /metrics, /health
    location ~ ^/(static/|mca/|webhooks/|auth/|api/|media/|share/|objects/|g2/|terminal/|admin/|metrics(/|$)|health(/|$)) {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $upstream_proto;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ── Static frontend (SPA) ───────────────────────────────────────────────
    location / {
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri $uri/ /index.html;
    }

    # index.html must never be cached (fresh deploys must be picked up)
    location = /index.html {
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
    }

    # Hashed assets can be cached forever
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        add_header Cache-Control "public, immutable";
        expires 1y;
        try_files $uri =404;
    }
}
