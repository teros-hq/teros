{
  "name": "teros",
  "version": "1.0.0-alpha",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "packages/*",
    "mcas/*"
  ],
  "scripts": {
    "sync": "yarn workspace @teros/backend sync",
    "dev:backend": "yarn workspace @teros/backend dev",
    "dev:container-agent": "yarn workspace @teros/backend dev:container-agent",
    "dev:app": "yarn workspace @teros/app start",
    "start:backend": "yarn workspace @teros/backend start",
    "start:app": "yarn workspace @teros/app start",
    "build": "yarn build:shared && yarn build:core && yarn build:backend",
    "build:shared": "yarn workspace @teros/shared build",
    "build:core": "yarn workspace @teros/core build",
    "build:backend": "yarn workspace @teros/backend build",
    "build:ios:preview": "cd packages/app && ./scripts/build-ios.sh preview",
    "build:ios:production": "cd packages/app && ./scripts/build-ios.sh production",
    "test": "yarn test:backend",
    "test:unit": "bun test tests/unit/",
    "test:backend:unit": "bun test packages/backend/tests/unit/",
    "test:backend": "yarn test:unit && yarn test:backend:unit",
    "test:core": "yarn workspace @teros/core test",
    "test:integration": "docker compose -f docker-compose.test.yml exec backend bun test packages/backend/tests/integration/",
    "test:all": "docker compose -f docker-compose.test.yml exec backend sh -c 'bun test tests/unit/ && bun test packages/backend/tests/unit/ && bun test packages/backend/tests/integration/'",
    "test:watch": "bun test tests/unit/ --watch",
    "smoke": "playwright test -c scripts/playwright-smoke/playwright.config.ts",
    "smoke:health": "playwright test -c scripts/playwright-smoke/playwright.config.ts --grep @health",
    "smoke:no-llm": "playwright test -c scripts/playwright-smoke/playwright.config.ts --grep-invert @llm",
    "smoke:seed": "node scripts/playwright-smoke/seed.mjs",
    "smoke:billing": "MONGODB_DATABASE=teros_billing BACKEND_URL=http://localhost:10021 TARGET_URL=http://localhost:8081 playwright test -c scripts/playwright-smoke/playwright.config.ts --grep @billing",
    "smoke:billing:seed": "MONGODB_DATABASE=teros_billing node scripts/playwright-smoke/seed.mjs",
    "smoke:report": "playwright show-report scripts/playwright-smoke/.report",
    "validate": "bun scripts/validate-manifests.ts",
    "validate:icons": "bun scripts/validate-icons.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "init:system-provider": "bun run packages/backend/src/scripts/init-system-provider.ts",
    "changelog": "npx tsx scripts/generate-changelog.ts",
    "changelog:release": "npx tsx scripts/generate-changelog.ts --release"
  },
  "resolutions": {
    "**/send/mime": "1.6.0",
    "@babel/core": ">=7.29.6",
    "@expo/vector-icons": "15.0.3",
    "@hono/node-server": ">=1.14.0",
    "@modelcontextprotocol/sdk": ">=1.0.0",
    "@opentelemetry/core": ">=2.8.0",
    "@protobufjs/utf8": ">=1.1.0",
    "@xmldom/xmldom": ">=0.8.13",
    "ajv": ">=6.12.8",
    "body-parser": ">=1.20.3",
    "brace-expansion": ">=2.1.4",
    "diff": ">=5.2.0",
    "expo": "54.0.29",
    "expo-constants": "18.0.12",
    "expo-font": "14.0.10",
    "expo-linking": "8.0.10",
    "expo-router": "6.0.19",
    "expo-secure-store": "15.0.8",
    "fast-uri": ">=3.0.0",
    "fast-xml-builder": ">=1.3.0",
    "file-type": ">=16.0.0",
    "follow-redirects": ">=1.15.6",
    "form-data": ">=4.0.6",
    "ip-address": ">=9.0.5",
    "js-yaml": ">=3.14.1",
    "linkify-it": ">=5.0.0",
    "lodash": ">=4.17.23",
    "mailparser": ">=3.7.0",
    "markdown-it": ">=14.1.0",
    "metro": "0.83.3",
    "metro-babel-transformer": "0.83.3",
    "metro-cache": "0.83.3",
    "metro-cache-key": "0.83.3",
    "metro-config": "0.83.3",
    "metro-core": "0.83.3",
    "metro-file-map": "0.83.3",
    "metro-minify-terser": "0.83.3",
    "metro-resolver": "0.83.3",
    "metro-runtime": "0.83.3",
    "metro-source-map": "0.83.3",
    "metro-symbolicate": "0.83.3",
    "metro-transform-plugins": "0.83.3",
    "metro-transform-worker": "0.83.3",
    "minimatch": ">=9.0.7",
    "node-forge": ">=1.3.1",
    "ono": ">=7.1.3",
    "parseuri": ">=0.0.6",
    "path-to-regexp": ">=0.1.10",
    "picomatch": ">=2.3.2",
    "postcss": ">=8.5.0",
    "prismjs": ">=1.30.0",
    "protobufjs": ">=7.5.5",
    "qs": ">=6.15.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "sharp": ">=0.33.0",
    "shell-quote": ">=1.8.4",
    "socket.io-parser": ">=4.2.4",
    "tar": ">=7.5.19",
    "undici": ">=6.28.0",
    "uuid": ">=11.1.1",
    "ws": ">=8.21.0",
    "yaml": ">=2.8.3",
    "axios": ">=1.19.0",
    "hono": ">=4.13.0",
    "nodemailer": ">=9.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@playwright/test": "1.58.0",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@tamagui/animations-css": "1.138.6",
    "lodash": ">=4.17.23",
    "qs": ">=6.15.2",
    "uuid": ">=11.1.1",
    "ws": ">=8.21.0",
    "yaml": ">=2.8.3"
  }
}
